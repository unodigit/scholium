# Scholium environment variables
# Copy this file to .env and fill in your values. Never commit .env.
#
# Two ways to run, one file:
#   - on the host (uv run python -m app): every setting below is optional, the
#     defaults are SQLite, files under CONTENT_DIR and eager jobs;
#   - in containers (npm run stack:up): compose.yaml reads this file as .env. See
#     "Local stack" at the end for what it adds.

# Database. SQLite (sqlite:///./scholium.db) is deprecated and is refused in
# production; it remains the development default only. The local stack defaults
# to PostgreSQL. Uncomment and edit to point at another database.
# DATABASE_URL=postgresql+psycopg://scholium:scholium-local-only@db:5432/scholium

# Content storage (STORAGE_BACKEND=fs)
CONTENT_DIR=./data/content

# Node signing key
NODE_KEY_PATH=./data/node.key

# JWT
JWT_SECRET=change-me-in-production

# Committee public key (for moderation)
COMMITTEE_PUBLIC_KEY=

# ORCID
ORCID_BASE_URL=https://orcid.org
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_MOCK=1

# arXiv
ARXIV_MOCK=1

# AI provider: fake | anthropic | ollama
AI_PROVIDER=fake
AI_HOSTED_MODEL=claude-sonnet-5-5
OLLAMA_URL=http://localhost:11434

# SMTP
SMTP_URL=

# Jobs
JOBS_EAGER=1

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
# Public origin of the web app (used for share/OG image URLs). Required in production;
# must not be a loopback address in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Runtime environment: dev | production (production refuses insecure defaults)
SCHOLIUM_ENV=dev
# Comma-separated browser origins allowed to call the API (CORS)
WEB_ORIGINS=http://localhost:3000
# Per-tier write throttling (1 = on)
RATE_LIMIT_ENABLED=1

# ---------------------------------------------------------------------------
# Local stack (npm run stack:up, see compose.yaml)
#
# Everything here has the same default in compose.yaml, so the stack also starts
# without a .env. The values below are for local development only: they are
# placeholders, not secrets, and the services listen on 127.0.0.1 only. Use
# different ones for anything another machine can reach.
#
# The api and worker are always started with STORAGE_BACKEND=s3 and
# JOBS_MODE=external, whatever this file says; SMTP_URL defaults to Mailpit
# when empty. Inside the stack the services find each other by name (db, minio,
# mailpit, sandbox), so the URLs below use those names. From the host use
# localhost and the published ports instead.
# ---------------------------------------------------------------------------

# Opt-in services: sandbox (the reproducibility runner). Comma-separated; every
# stack:* script honours it.
# COMPOSE_PROFILES=sandbox

# PostgreSQL 16 with pgvector. The stack builds DATABASE_URL from these. The
# password goes into a URL unescaped, so keep it to letters, digits and "-_.".
POSTGRES_USER=scholium
POSTGRES_PASSWORD=scholium-local-only
POSTGRES_DB=scholium

# Object storage. STORAGE_BACKEND=fs (the default) keeps objects under
# CONTENT_DIR; s3 keeps them in S3_BUCKET at S3_ENDPOINT_URL through the S3 API.
STORAGE_BACKEND=fs
S3_BUCKET=scholium
S3_REGION=us-east-1
# 1 addresses the bucket as endpoint/bucket, which MinIO and most self-hosted
# servers need; 0 for AWS S3 and Cloudflare R2.
S3_FORCE_PATH_STYLE=1
# The stack points these at its MinIO. Set all three to use another S3-API
# service instead (the credentials then default to the MinIO ones below).
# S3_ENDPOINT_URL=http://minio:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# MinIO's administrator. The bucket is created with it, and the api and worker
# use it too unless S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY are set. The
# password needs at least 8 characters.
MINIO_ROOT_USER=scholium-minio
MINIO_ROOT_PASSWORD=scholium-minio-secret

# Where the api and worker send mail. Empty means the stack's Mailpit, whose
# inbox is at http://localhost:8025.
# SMTP_URL=smtp://mailpit:1025

# Node signing key (hex or base64, 32 or 64 bytes) and the other secrets
# production needs. Empty is fine for development. The stack can also make a
# key on its shared volume: podman-compose exec api python -m app.modules.admin init-node
NODE_KEY=
REVIEW_UNIQUENESS_KEY=
ANTHROPIC_API_KEY=

# Sandbox runner (COMPOSE_PROFILES=sandbox). Point the api at it with
# SANDBOX_BACKEND=remote; the token is shared by both and must be at least 32
# characters (openssl rand -hex 32). SANDBOX_RUNNER is the engine the runner
# itself uses, docker or podman.
# SANDBOX_BACKEND=remote
# SANDBOX_URL=http://sandbox:8001
SANDBOX_TOKEN=
# SANDBOX_RUNNER=podman
# REPRO_DOCKER_IMAGE=python:3.12-slim

# Host ports (all bound to 127.0.0.1). The web bundle has the api's address
# built in, so after changing API_PORT or WEB_PORT also set NEXT_PUBLIC_API_URL,
# NEXT_PUBLIC_SITE_URL and WEB_ORIGINS above to match, and run stack:up again.
# API_PORT=8000
# WEB_PORT=3000
# DB_PORT=5433
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025

# Images and tags. MinIO no longer publishes minio/minio, so the default is the
# community build pgsty/minio; the image must contain the server, mc and curl.
# MINIO_IMAGE=docker.io/pgsty/minio:RELEASE.2026-08-04T00-00-00Z
# POSTGRES_IMAGE=docker.io/pgvector/pgvector:pg16
# MAILPIT_IMAGE=docker.io/axllent/mailpit:v1.34.0
# SCHOLIUM_API_IMAGE=scholium-api:local
# SCHOLIUM_WEB_IMAGE=scholium-web:local
