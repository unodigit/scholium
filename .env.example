# Scholium environment variables
# Copy this file to .env and fill in your values. Never commit .env.

# Database (SQLite)
DATABASE_URL=sqlite:///./scholium.db

# Content storage
CONTENT_DIR=./data/content

# Node signing key
NODE_KEY_PATH=./data/node.key

# JWT
JWT_SECRET=change-me-in-production

# Committee public key (for moderation)
COMMITTEE_PUBLIC_KEY=

# ORCID
ORCID_BASE_URL=https://orcid.org
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_MOCK=1

# arXiv
ARXIV_MOCK=1

# AI provider: fake | anthropic | ollama
AI_PROVIDER=fake
AI_HOSTED_MODEL=claude-sonnet-5-5
OLLAMA_URL=http://localhost:11434

# SMTP
SMTP_URL=

# Jobs
JOBS_EAGER=1

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000