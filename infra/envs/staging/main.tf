# Staging environment for Scholium.
#
# One Hetzner Cloud host running the repository's compose stack, one
# object-store module, and the Cloudflare edge in front of the API. The
# object-store provider is selected by variable: both module blocks below use
# the same shared contract (s3_endpoint_url, s3_region, s3_bucket,
# s3_access_key_id, s3_secret_access_key), so switching between AWS S3 and
# Cloudflare R2 changes exactly one value and no application setting.
#
# Credentials come from the environment, never from committed files:
#   HCLOUD_TOKEN         Hetzner Cloud API token
#   CLOUDFLARE_API_TOKEN Cloudflare API token (Tunnel, DNS and Zone WAF edit)
#   AWS_*                AWS credentials when object_store_provider = "s3"
#   TF_VAR_state_encryption_passphrase  passphrase for state encryption

terraform {
  required_version = ">= 1.9.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "6.70.0"
    }
    cloudflare = {
      source  = "cloudflare/cloudflare"
      version = "5.20.0"
    }
    hcloud = {
      source  = "hetznercloud/hcloud"
      version = "1.70.2"
    }
    random = {
      source  = "hashicorp/random"
      version = "3.9.1"
    }
  }
}

provider "aws" {
  region = var.aws_region
}

# Reads CLOUDFLARE_API_TOKEN.
provider "cloudflare" {}

# Reads HCLOUD_TOKEN.
provider "hcloud" {}

# Secrets generated by OpenTofu live only in the encrypted state; nothing is
# committed and no secret has a default in variables.tf.
resource "random_password" "postgres" {
  length  = 32
  special = false
}

resource "random_password" "jwt_secret" {
  length  = 64
  special = false
}

resource "random_password" "review_uniqueness_key" {
  length  = 64
  special = false
}

resource "random_id" "node_key" {
  byte_length = 32
}

# The two implementations of the object-store contract. `count` makes exactly
# one of them active; `local.object_store` below then reads the shared outputs
# without caring which provider produced them.
module "object_store_s3" {
  source = "../../modules/object-store-s3"
  count  = var.object_store_provider == "s3" ? 1 : 0

  bucket_name   = var.object_bucket_name
  iam_user_name = "${var.environment_name}-scholium-s3"
  force_destroy = var.object_store_force_destroy
  tags          = local.tags
}

module "object_store_r2" {
  source = "../../modules/object-store-r2"
  count  = var.object_store_provider == "r2" ? 1 : 0

  account_id   = var.cloudflare_account_id
  bucket_name  = var.object_bucket_name
  jurisdiction = var.r2_jurisdiction
  location     = var.r2_location
  token_name   = "${var.environment_name}-scholium-s3-access"
}

module "edge" {
  source = "../../modules/edge-cloudflare"

  account_id   = var.cloudflare_account_id
  zone_id      = var.cloudflare_zone_id
  api_hostname = var.api_hostname
  api_origin   = var.api_origin
  tunnel_name  = "${var.environment_name}-scholium-api"
}

module "host_vm" {
  source = "../../modules/host-vm"

  name              = var.environment_name
  server_type       = var.server_type
  location          = var.location
  image             = var.image
  ssh_keys          = var.ssh_keys
  volume_size       = var.volume_size
  ssh_allowed_cidrs = var.ssh_allowed_cidrs
  labels            = local.tags

  repository_url             = var.repository_url
  repository_ref             = var.repository_ref
  repository_ssh_private_key = var.repository_ssh_private_key

  # The tunnel connector runs next to the compose stack, so the edge module's
  # api_origin points at the API port the host publishes.
  tunnel_token = module.edge.tunnel_token

  stack_environment = local.stack_environment
}

locals {
  tags = {
    application = "scholium"
    environment = var.environment_name
    managed_by  = "opentofu"
  }

  # Exactly one object-store module is expanded (validated on the variable).
  object_store = one(concat(module.object_store_s3[*], module.object_store_r2[*]))

  api_url     = module.edge.api_url
  site_url    = coalesce(var.site_url, "https://${var.api_hostname}")
  web_origins = length(var.web_origins) > 0 ? var.web_origins : ["https://${var.api_hostname}"]

  database_url = format(
    "postgresql+psycopg://%s:%s@%s:5432/%s",
    var.database_user,
    urlencode(random_password.postgres.result),
    var.database_host,
    var.database_name,
  )

  sandbox_environment = var.sandbox_backend == "remote" ? {
    SANDBOX_URL   = coalesce(var.sandbox_url, "")
    SANDBOX_TOKEN = coalesce(var.sandbox_token, "")
  } : {}

  # The compose stack reads these from its .env. They map one-to-one onto the
  # application settings; the S3_* names are the object-store contract's.
  # var.stack_environment is merged last so an operator can override anything.
  stack_environment = merge(
    {
      SCHOLIUM_ENV = "production"

      DATABASE_URL      = local.database_url
      POSTGRES_USER     = var.database_user
      POSTGRES_PASSWORD = random_password.postgres.result
      POSTGRES_DB       = var.database_name

      STORAGE_BACKEND      = "s3"
      S3_ENDPOINT_URL      = local.object_store.s3_endpoint_url
      S3_REGION            = local.object_store.s3_region
      S3_BUCKET            = local.object_store.s3_bucket
      S3_ACCESS_KEY_ID     = local.object_store.s3_access_key_id
      S3_SECRET_ACCESS_KEY = local.object_store.s3_secret_access_key
      S3_FORCE_PATH_STYLE  = tostring(var.s3_force_path_style)

      JOBS_MODE  = "external"
      JOBS_EAGER = "0"

      JWT_SECRET            = random_password.jwt_secret.result
      REVIEW_UNIQUENESS_KEY = random_password.review_uniqueness_key.result
      NODE_KEY              = random_id.node_key.hex
      COMMITTEE_PUBLIC_KEY  = var.committee_public_key

      SMTP_URL            = var.smtp_url
      ORCID_CLIENT_ID     = var.orcid_client_id
      ORCID_CLIENT_SECRET = var.orcid_client_secret
      ORCID_MOCK          = "0"
      ARXIV_MOCK          = "0"

      AI_PROVIDER       = var.ai_provider
      ANTHROPIC_API_KEY = coalesce(var.anthropic_api_key, "")

      WEB_ORIGINS          = join(",", local.web_origins)
      NEXT_PUBLIC_API_URL  = local.api_url
      NEXT_PUBLIC_SITE_URL = local.site_url
      RATE_LIMIT_ENABLED   = "1"

      SANDBOX_BACKEND = var.sandbox_backend
    },
    local.sandbox_environment,
    var.stack_environment,
  )
}

output "api_url" {
  description = "Public API URL through the Cloudflare edge."
  value       = module.edge.api_url
}

output "tunnel_id" {
  description = "Id of the Cloudflare Tunnel that carries API traffic."
  value       = module.edge.tunnel_id
}

output "host_ipv4_address" {
  description = "Public IPv4 address of the staging host."
  value       = module.host_vm.ipv4_address
}

output "ssh_command" {
  description = "SSH command for the staging host."
  value       = module.host_vm.ssh_command
}

output "object_store_provider" {
  description = "The object-store implementation in use: s3 or r2."
  value       = var.object_store_provider
}

output "s3_endpoint_url" {
  description = "Endpoint of the provisioned object store, for verification."
  value       = nonsensitive(local.object_store.s3_endpoint_url)
}

output "s3_bucket" {
  description = "Bucket of the provisioned object store, for verification."
  value       = nonsensitive(local.object_store.s3_bucket)
}
