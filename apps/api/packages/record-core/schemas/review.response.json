{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scholium.network/schemas/review.response.json",
  "title": "review.response record body",
  "description": "A paper author's point-by-point response to a formal review, keyed by rubric dimension.",
  "type": "object",
  "required": ["items"],
  "allOf": [
    {
      "anyOf": [
        {"required": ["review"]},
        {"required": ["reviewCid"]}
      ]
    }
  ],
  "properties": {
    "review": {
      "$ref": "#/$defs/cid",
      "description": "Record id of the review.formal being answered."
    },
    "reviewCid": {
      "$ref": "#/$defs/cid"
    },
    "replyCid": {
      "$ref": "#/$defs/cid"
    },
    "text": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {"type": "string", "minLength": 1},
          {
            "type": "object",
            "properties": {
              "dimension": {
                "type": "string",
                "enum": [
                  "soundness",
                  "evidence",
                  "reproducibility",
                  "novelty",
                  "clarity",
                  "limitations",
                  "general"
                ]
              },
              "reply": {"type": "string"},
              "text": {"type": "string"},
              "body": {"type": "string"}
            },
            "additionalProperties": true
          }
        ]
      }
    }
  },
  "$defs": {
    "cid": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
