{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scholium.network/schemas/rendition.json",
  "title": "rendition record body",
  "description": "A node-signed record of the sanitized files and tool versions produced for a version.",
  "type": "object",
  "required": ["files"],
  "allOf": [
    {
      "anyOf": [
        {"required": ["source"]},
        {"required": ["sourceVersion"]},
        {"required": ["version"]}
      ]
    },
    {
      "anyOf": [
        {"required": ["tools"]},
        {"required": ["toolVersions"]}
      ]
    }
  ],
  "properties": {
    "source": {
      "$ref": "#/$defs/cid",
      "description": "Record id of the version this rendition was made from."
    },
    "sourceVersion": {
      "$ref": "#/$defs/cid"
    },
    "version": {
      "$ref": "#/$defs/cid"
    },
    "paper": {
      "$ref": "#/$defs/cid"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "cid"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "cid": {"type": "string", "minLength": 1},
          "size": {"type": "integer", "minimum": 0},
          "mediaType": {"type": "string"},
          "role": {"type": "string"},
          "scanStatus": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {"type": "string", "minLength": 1},
          {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "version": {"type": "string"}
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "toolVersions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {"type": "string", "minLength": 1},
          {"type": "object"}
        ]
      }
    }
  },
  "$defs": {
    "cid": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
