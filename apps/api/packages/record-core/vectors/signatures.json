{
  "version": 1,
  "description": "Cross-language test vectors for Scholium record signatures. The sig of a record is the Ed25519 signature (unpadded base64url) by the author's key over dag_cbor_hex — the canonical DAG-CBOR bytes of the envelope fields v, type, author, created, prev, body, proofs, excluding id and sig — exactly the bytes the record id is hashed over. Every implementation must derive each key's public_key_hex and did_key from seed_hex alone, each vector's sig from its envelope and the named key alone, accept every entry of vectors, reject every entry of invalid (verification returns false; set replaces a dotted envelope path, sign_with re-signs the untampered envelope with another key, corrupt_sig flips a byte of the signature), and reject every input of invalid_did_keys with the stated error kind: format (not a did:key:z… string), encoding (not valid base58btc) or key (valid multibase but not a 34-byte ed25519-pub multikey).",
  "signature": {
    "algorithm": "Ed25519",
    "preimage": "record_bytes(envelope): canonical DAG-CBOR of the seven content fields, excluding id and sig",
    "encoding": "base64url-unpadded",
    "library": "PyNaCl (libsodium)"
  },
  "did_key": {
    "method": "did:key",
    "multicodec": "0xed01",
    "multicodec_name": "ed25519-pub",
    "multibase": "base58btc",
    "prefix": "did:key:z",
    "public_key_length": 32
  },
