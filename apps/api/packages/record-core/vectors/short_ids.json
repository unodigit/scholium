{
  "version": 1,
  "description": "Cross-language test vectors for Scholium sch: short ids. A paper short id is derived from the genesis record CID: the first 50 bits of its sha2-256 digest as 10 lowercase RFC 4648 base32 characters, followed by a 2-character CRC-10/ATM checksum of those 50 bits, grouped xxxx-xxxx-xxxx behind the sch: prefix. A version id appends /vN. Every implementation must derive short_id and version_ids from genesis_cid alone, parse every entry of parse to the stated result and reject every entry of invalid: format means the string is not shaped like a sch: id, checksum means it is shaped correctly but the checksum does not match.",
  "short_id": {
    "prefix": "sch:",
    "alphabet": "abcdefghijklmnopqrstuvwxyz234567",
    "payload_length": 10,
    "checksum_length": 2,
    "group_size": 4,
    "payload": "base32 (RFC 4648, lowercase, unpadded) of the sha2-256 digest of the genesis CID, first 10 characters (the first 50 bits); never the leading characters of the CID string",
    "checksum": "CRC-10/ATM (width 10, poly 0x233, init 0, no reflection, xorout 0) over the 50 payload bits, most significant bit first; written as two base32 characters, high 5 bits first",
    "version": "/v followed by a decimal integer from 1 to 999999999 without leading zeros",
    "case": "parsing is case-insensitive; the canonical form is lowercase"
  },
