    "cid_version": 1,
    "codec": "dag-cbor",
    "codec_code": "0x71",
    "hash": "sha2-256",
    "base": "base32"
  },
  "envelope_fields": [
    "v",
    "type",
    "author",
    "created",
    "prev",
    "body",
    "proofs"
  ],
  "excluded_fields": [
    "id",
    "sig"
  ],
