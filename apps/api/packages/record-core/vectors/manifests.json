{
  "version": 1,
  "description": "Cross-language test vectors for Scholium manifest bodies. A manifest body is {\"files\": [...]} where each entry carries exactly path, cid, size, mediaType and role. Every implementation must canonicalize each vector's body into files (entries kept in order, entry fields re-ordered to file_fields) and reject every entry of invalid with the stated error kind: body means the body itself is malformed, path/cid/size/mediaType/role mean that field of some files[i] fails its rule, fields means an entry is missing a field, carries an extra one or is not a mapping.",
  "manifest": {
    "record_type": "manifest",
    "body_fields": [
      "files"
    ],
    "file_fields": [
      "path",
      "cid",
      "size",
      "mediaType",
      "role"
    ],
    "roles": [
      "bibliography",
      "code",
      "cover",
      "dataset",
      "figure",
      "manuscript",
      "other",
      "source",
      "style",
      "supplementary",
      "table"
    ],
    "max_file_size": 9007199254740991,
    "max_path_length": 1024,
    "files": "a non-empty list; paths must be unique across it",
    "path": "normalized relative POSIX path: '/' separators, no leading '/', no empty, '.' or '..' components, no backslashes, no control characters, at most max_path_length characters",
    "cid": "canonical CIDv1 raw sha2-256 base32 file id as pinned by vectors/file_ids.json; record ids and any other CID spelling are rejected",
    "size": "the file's exact byte length: an integer from 0 to max_file_size (the largest integer every JSON number port represents exactly); booleans and floats are rejected",
    "mediaType": "bare lowercase RFC 6838 type/subtype, no parameters, no wildcards, no uppercase"
  },
